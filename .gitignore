# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated / large local artifacts.
# Note: comments must be on their own line - gitignore does NOT strip a
# trailing comment, so `/data/osm/  # 65MB` is a pattern with "# 65MB" in it.

# 65MB OSM extract plus the ~240MB OSRM graph built from it
/data/osm/
# File-backed state; regenerated on first page load
/data/store/
# The call ledger
/data/telemetry/
# Cached Open-Meteo responses (the 1991-2020 normals are ~11k days)
/data/fixtures/world/
# Copied from node_modules by scripts/copy-maplibre-worker.mjs on predev
/public/maplibre/

# Recorded Mireye responses are deliberately NOT ignored: committing them is
# what lets the demo run offline, without a key, and without spending credits.

# The template is a placeholder file and belongs in the repo.
!.env.example
