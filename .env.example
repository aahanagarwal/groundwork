# ---------------------------------------------------------------------------
# Groundwork - environment
# Copy to `.env` and fill in. Everything except DATABASE_URL is optional:
# without keys the app runs entirely off recorded fixtures (see docs/README.md).
# ---------------------------------------------------------------------------

# Postgres. Works locally and on Vercel - a free Neon database is the fastest
# path (https://neon.tech), no local Postgres install needed.
DATABASE_URL="postgresql://user:password@host/groundwork?sslmode=require"

# --- Mireye Earth (the ground layer) --------------------------------------
# Dashboard token from https://mireye.com. Sent as `Authorization: Bearer`.
MIREYE_API_KEY=""
MIREYE_BASE_URL="https://api.mireye.com"

# Hard ceiling on credits any single /v1/proximity call may spend. Mireye
# refuses the request (422, before charging) if the shape would cost more.
# An 8-minute isochrone at default probe density costs ~960 credits.
MIREYE_MAX_CREDITS_PER_CALL="1200"

# "record"  - call the live API and write the response to data/fixtures/mireye/
# "replay"  - never call the API; read fixtures only (default without a key)
# "live"    - call the API every time, no fixture write
MIREYE_MODE="record"

# --- OpenAI (the reasoning layer) ------------------------------------------
OPENAI_API_KEY=""
# Flagship reasoning model: planner + attribution narration.
OPENAI_MODEL="gpt-5.6-sol"
# Balanced model: the six decision modules.
OPENAI_MODEL_MODULES="gpt-5.6-terra"
# Cheap model: summarisation, titles, and other chores.
OPENAI_MODEL_CHEAP="gpt-5.6-luna"

# --- Demo ------------------------------------------------------------------
# Which seeded scenario the app boots into. Switch it live at /admin.
GROUNDWORK_DEFAULT_SCENARIO="road-closure-dip"

# --- Reasoning layer ---------------------------------------------------------
# Which provider the agents talk to. "openai" (default) or "groq".
#
# Groq serves an OpenAI-compatible API, so switching is these three variables
# and nothing else - no code change. It is the cheap way to develop against the
# agents; move LLM_PROVIDER back to "openai" to ship.
#
# With no key set the agents do not fail: the narrator renders its
# deterministic template, the week-ahead projection still computes from the
# till, and every panel says on screen that no model was configured.
LLM_PROVIDER="openai"

# Groq (only read when LLM_PROVIDER=groq)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_MODEL_CHEAP="llama-3.1-8b-instant"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
